# Copia para .env e ajusta (o .env não vai para o GitHub).
# O docker compose funciona sem este ficheiro, com os valores por defeito.

POSTGRES_DB=scouting
POSTGRES_USER=scouting
# Atenção: a palavra-passe só é aplicada quando o volume da base de dados é criado.
# Para a mudar depois: docker compose down -v (apaga os dados) e voltar a arrancar.
POSTGRES_PASSWORD=muda-esta-palavra-passe

# Porta onde a app fica acessível (http://localhost:8080)
PORTA_WEB=8080
# Quem pode ligar-se a essa porta. Por omissão, qualquer dispositivo da tua rede (um tablet no pavilhão, por exemplo).
# Com um proxy HTTPS no mesmo computador (Caddy, Tailscale Funnel), usa 127.0.0.1 para só o proxy chegar à app.
#INTERFACE_WEB=127.0.0.1

# Fuso horário das datas nos ficheiros Excel exportados (nome IANA, p. ex. Europe/Lisbon, Atlantic/Azores)
FUSO_HORARIO=Europe/Lisbon

# ---------------------------------------------------------------------
# Email de confirmação das contas novas
# ---------------------------------------------------------------------
# Sem nada disto, os emails vão para a caixa de correio de teste (Mailpit): abre http://localhost:8025 para os ver.
# Nenhum sai para a internet. Para enviar emails a sério, preenche estas linhas com os dados do teu servidor de email.
#
# Exemplo com o Gmail (precisa de uma "palavra-passe de app": https://myaccount.google.com/apppasswords):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORTA=587
#   EMAIL_UTILIZADOR=o.teu.email@gmail.com
#   EMAIL_SENHA=palavra-passe-de-app
#   EMAIL_SSL=true
#   EMAIL_DE=o.teu.email@gmail.com
#
# EMAIL_SSL=true liga com STARTTLS (porta 587). A porta 465 (TLS direto) não é suportada.
#EMAIL_HOST=
#EMAIL_PORTA=587
#EMAIL_UTILIZADOR=
#EMAIL_SENHA=
#EMAIL_SSL=true
#EMAIL_DE=

# Endereço da app como as pessoas o veem (vai dentro do link do email). Muda-o se não usares http://localhost:8080
# (por exemplo, se mudares PORTA_WEB ou puseres a app num domínio: https://scouting.exemplo.pt).
URL_PUBLICO=http://localhost:8080

# ---------------------------------------------------------------------
# Administração
# ---------------------------------------------------------------------
# Os emails das contas que administram a app (vários, separados por vírgula). A conta tem de existir e ter o email
# confirmado; passa a admin na próxima vez que entrar (ou ao arrancar a API, se já existir). Quem é admin vê a ligação
# «Administração» no menu: contas, jogos e registo de alterações. Sem isto ninguém é admin.
#ADMIN_EMAILS=joaooliveira@playbyplay.pt

# ---------------------------------------------------------------------
# Para pôr a app na internet (ver «Pôr na internet» no README)
# ---------------------------------------------------------------------
# - POSTGRES_PASSWORD (acima): uma palavra-passe forte, antes de criares a base de dados.
# - URL_PUBLICO (acima): o endereço https que as pessoas usam, por exemplo https://o-meu-pc.o-meu-tailnet.ts.net
# - EMAIL_* (acima): um servidor de email a sério, senão ninguém recebe a ligação para confirmar a conta.
# - ADMIN_EMAILS (acima): o email da conta que administra a app.
